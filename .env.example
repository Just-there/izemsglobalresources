# ---------------------------------------------------------------------------
# IZEMS Global Resources — environment variables
# Copy this file to `.env` and fill in the values from your own Supabase
# project (Project Settings -> API). Nothing in this app is tied to Lovable.
# ---------------------------------------------------------------------------

# Browser-visible (safe to expose) — used by the React app
VITE_SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-anon-or-publishable-key"
VITE_SUPABASE_PROJECT_ID="YOUR-PROJECT-REF"

# Server-side copies of the same public values (used during SSR)
SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
SUPABASE_PUBLISHABLE_KEY="your-anon-or-publishable-key"
SUPABASE_PROJECT_ID="YOUR-PROJECT-REF"

# SECRET — never commit, never expose to the browser.
# Required only for owner-level admin actions (creating/deleting staff logins).
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"